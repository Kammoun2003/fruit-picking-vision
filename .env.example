# Copy to .env (git-ignored) and fill in. Never commit the filled-in file.
ARK_API_KEY=
MODEL_ID=
# Volcengine Ark by default; any OpenAI-compatible base URL works (https only).
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# disabled for Ark models; auto omits the parameter for other providers.
LLM_THINKING=disabled
